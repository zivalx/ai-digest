# LLM Provider API Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
XAI_API_KEY=your_xai_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Data Source API Keys
# Reddit
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=DigestAI/1.0

# Telegram
TELEGRAM_API_ID=your_telegram_api_id_here
TELEGRAM_API_HASH=your_telegram_api_hash_here
TELEGRAM_PHONE_NUMBER=your_phone_number_here

# Twitter (X)
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# Optional: Override default settings
# MAX_VIDEOS_PER_CHANNEL=5
# DAYS_BACK=7
# OUTPUT_DIR=output

# Channel-Intelligence Feeder
# trender ingest endpoint base URL
TRENDER_BASE_URL=http://localhost:8000
# Optional bearer token for trender ingest (leave unset for local/open ingest)
# TRENDER_INGEST_TOKEN=
# Anthropic model used for pick extraction
ANTHROPIC_MODEL=claude-sonnet-5
# xAI (Grok) model used for pick extraction fallback. "grok-4" is current as
# of this writing but not guaranteed -- override if xAI renames/retires it.
XAI_MODEL=grok-4
# DeepSeek model used for pick extraction fallback
DEEPSEEK_MODEL=deepseek-chat
# Ordered, comma-separated provider fallback chain for extraction
# (quality-first: try anthropic, then xai, then deepseek)
LLM_PROVIDERS=anthropic,xai,deepseek
# Feeder run interval in seconds (default 6h = 21600)
FEEDER_INTERVAL_SECONDS=21600
# Drop extracted picks below this model confidence, 0..1 (default 0.3)
EXTRACTION_MIN_CONFIDENCE=0.3
# Enable the background feeder scheduler on app startup (default false)
FEEDER_ENABLED=false
