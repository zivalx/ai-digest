# Database
POSTGRES_USER=digest
POSTGRES_PASSWORD=changeme
POSTGRES_DB=digest

# LLM
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5       # default, override if needed
LLM_PROVIDERS=anthropic               # fallback chain: anthropic,xai,deepseek

# Finance feeder
FEEDER_ENABLED=true
FEEDER_INTERVAL_SECONDS=21600         # 6h in production; use 120 for testing

# Trender connection
TRENDER_BASE_URL=http://trender-app:8000   # internal docker network (same host)
TRENDER_INGEST_TOKEN=                      # set a shared secret in production

# YouTube - no API key needed for public transcript fetching
# YOUTUBE_PUBLIC_* env vars are not read; credential_ref is a label only for YouTube
