# ai-digest configuration template.
#
# Production (Hetzner): copy to /opt/ai-digest/.env, fill it in with an editor on the server
# (never echo a secret into shell history), chmod 0600. docker-compose.prod.yml reads it both
# for its own ${...} values and as the app container's environment.
# Local development: backend/.env is read instead (copy this file there); with no DATABASE_URL
# the app uses a local SQLite file, and the feeder stays off unless FEEDER_ENABLED=true.
# `.env` is gitignored: real secrets live there, never here.

# ── Database (compose builds DATABASE_URL from these; do not set DATABASE_URL in production) ──
POSTGRES_USER=digest
# Generate with: openssl rand -hex 24   (hex only: it is placed inside a URL)
POSTGRES_PASSWORD=
POSTGRES_DB=digest

# ── LLM: extracts ticker picks from transcripts and messages ──────────────────────────────
# Comma-separated provider order. Every listed provider needs its key below, or extraction
# fails for every item ("API key environment variable not set"). The shipped default in code is
# "anthropic,xai,deepseek"; one provider is the lean choice here.
LLM_PROVIDERS=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Only if listed in LLM_PROVIDERS:
# XAI_API_KEY=
# XAI_MODEL=grok-4
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# OPENAI_API_KEY=            # also used by the general (non-finance) digest summaries
# OPENAI_MODEL=gpt-4o-mini
# claude_code (local runs only): extraction through this machine's signed-in Claude Code CLI.
# CLAUDE_CODE_MODEL=sonnet
# Picks below this confidence are dropped before they are pushed.
EXTRACTION_MIN_CONFIDENCE=0.3

# ── Finance feeder ──────────────────────────────────────────────────────────────────────
# docker-compose.prod.yml defaults this to true (the code default is false).
FEEDER_ENABLED=true
# Seconds between cycles. 21600 = 6 h. /health/deep tolerates one missed tick (limit is
# 2 x this + 30 min), so a faster interval makes the watchdog stricter. Use 120 only for testing.
FEEDER_INTERVAL_SECONDS=21600

# ── trender (where the picks go) ────────────────────────────────────────────────────────
# Same docker network as trender, not the public edge: trender-app listens on 8000.
TRENDER_BASE_URL=http://trender-app:8000
# Must equal TRENDER_INGEST_TOKEN in /opt/trender/.env (trender fails closed with 503 until it
# is set). Generate once with: openssl rand -hex 32. Rotation: runbooks/rotate-secrets.md.
TRENDER_INGEST_TOKEN=
# How long one push request may take before it counts as failed (trender re-scores after every
# request, so a large batch can be slow), and how many calls/mentions go in one request.
TRENDER_TIMEOUT_SECONDS=120
TRENDER_PUSH_BATCH_SIZE=50

# ── Run logs ────────────────────────────────────────────────────────────────────────────
# Every feeder cycle and every backfill writes its log to a file here by itself (one
# <time>_<source>.log plus a .summary.json with the counts per outcome and reason), so no shell
# redirection is needed. Default backend/logs/ (gitignored); docker-compose.prod.yml sets
# /data/logs, on the data volume. Read it with: docker exec ai-digest-app ls /data/logs
# LOG_DIR=

# ── YouTube ─────────────────────────────────────────────────────────────────────────────
# No API key: captions come from YouTube's public transcript endpoint, channel lists from yt-dlp.
# Whisper is the fallback for videos without captions and loads a speech model into RAM for
# every collection (base is about 300-500 MB and keeps the CPU busy). Empty = off (such videos
# are skipped), tiny = about 150 MB. A source's own collect_spec "whisper_model" still wins.
YOUTUBE_WHISPER_MODEL=

# ── Telegram sources (optional) ─────────────────────────────────────────────────────────
# A telegram source names a credential_ref (say TGFEED); the app reads TGFEED_API_ID,
# TGFEED_API_HASH, TGFEED_PHONE and optionally TGFEED_PASSWORD (2FA). The login needs a one-time
# code that a headless server cannot read: log in once locally, then copy the .session file to
# the volume as /data/telegram.session (see README.md, Deployment).
# TGFEED_API_ID=
# TGFEED_API_HASH=
# TGFEED_PHONE=
# TGFEED_PASSWORD=

# ── Other source types (the Sources page only offers youtube and telegram for finance) ─────
# Reddit  <REF>_CLIENT_ID, <REF>_CLIENT_SECRET, <REF>_USER_AGENT
# Twitter <REF>_BEARER_TOKEN        GNews <REF>_API_KEY

# ── Browser access (leave unset in production) ──────────────────────────────────────────
# The UI is served by the app itself, same origin. Only the React dev server (localhost:3000)
# needs CORS, which is the built-in default. Comma-separated override:
# CORS_ORIGINS=http://localhost:3000
